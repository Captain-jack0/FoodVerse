{
  "expo": {
    "name": "Kukki Kitchen",
    "slug": "kukki-kitchen",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "kukkikitchen",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.captainmery.kukkikitchen"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FCF6E8",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.captainmery.kukkikitchen"
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png",
      "name": "Kukki Kitchen",
      "shortName": "Kukki",
      "lang": "tr",
      "themeColor": "#fbf8ff",
      "backgroundColor": "#fcf6e8"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FCF6E8",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 160
        }
      ],
      "expo-sqlite"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
